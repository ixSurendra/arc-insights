{
  "name": "@arc-insights/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.ts --outdir=./dist --target=bun",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "bun run scripts/bootstrap-db.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "loadtest:duckdb": "bun run scripts/loadtest-duckdb.ts"
  },
  "dependencies": {
    "elysia": "^1.1.0",
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/swagger": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0",
    "mysql2": "^3.11.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "duckdb-async": "^1.1.0",
    "@types/node": "^22.0.0"
  }
}
