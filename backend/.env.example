# Copy to .env.local and fill in real values. .env* files are gitignored
# except for this example.

# ─── LLM provider ────────────────────────────────────────────────────
# Phase 1 default: Ollama Cloud (https://ollama.com).
# Phase 2 will let each tenant pick their own provider in Settings → AI;
# until then these env vars drive the global default for the dev tenant.
ARC_LLM_PROVIDER=ollama-cloud
ARC_LLM_BASE_URL=https://ollama.com
ARC_LLM_API_KEY=replace-me

# Model presets (correspond to Settings → AI presets: high/balanced/fast)
ARC_LLM_MODEL_HIGH_QUALITY=gpt-oss:120b
ARC_LLM_MODEL_BALANCED=gpt-oss:20b
ARC_LLM_MODEL_FAST=gpt-oss:20b
