# Match .gitignore for the most part — but with a few extras Docker needs.

# Dependencies (re-installed inside the builder)
node_modules/
**/node_modules/

# Build artifacts (re-built inside the builder)
dist/
build/
.turbo/
**/dist/
**/build/

# Test artifacts
coverage/
playwright-report/
test-results/

# Environment files (never bake secrets into images)
.env
.env.local
.env.*.local

# Git metadata
.git/
.gitignore

# CI / GitHub
.github/

# Husky hooks (host-only)
.husky/

# Editor / OS junk
.DS_Store
*.swp
.vscode/
.idea/

# Logs
*.log

# Dockerfile itself isn't useful to copy into the image
Dockerfile
.dockerignore
