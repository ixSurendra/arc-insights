{
  "name": "@arc-insights/sdk",
  "version": "0.1.0",
  "description": "Type-safe SDK for Arc Insights — embed dashboards in any React, Vue, or vanilla app.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=./dist --target=browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.1.0",
    "elysia": "^1.1.0"
  }
}
