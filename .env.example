# Arc Insights — example environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ─── Runtime ──────────────────────────────────────────────────────
PORT=3000
APP_VERSION=dev
NODE_ENV=development

# ─── Metadata DB (Postgres) ───────────────────────────────────────
# Local docker-compose default. Override for cloud/on-prem.
DATABASE_URL=postgresql://arc:arc_dev@localhost:5432/arc_insights
DATABASE_POOL_MAX=10

# ─── Cache ────────────────────────────────────────────────────────
# Valkey for cloud; for single-binary on-prem this can be a Bun SQLite path.
CACHE_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-bytes-of-hex
EMBED_JWT_SECRET=replace-me-with-32-bytes-of-hex

# ─── LLM (BYO endpoint) ───────────────────────────────────────────
# Cloud: https://api.openai.com/v1 | https://api.anthropic.com | Azure OpenAI URL
# Air-gapped: http://localhost:11434/v1 (Ollama)
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
# Set true to disable every AI surface (product still works without AI).
LLM_DISABLED=false

# ─── Telemetry ────────────────────────────────────────────────────
# Set to your collector. Empty + TELEMETRY_ENABLED=false for air-gapped.
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_ENABLED=true
